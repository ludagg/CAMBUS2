rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper : Vérifie si l'utilisateur est connecté
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper : Vérifie le rôle de l'utilisateur dans son document profile
    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // --- COLLECTION USERS ---
    match /users/{userId} {
      // Un utilisateur peut lire et écrire son propre document. 
      // Le Super Admin peut tout voir et tout modifier (ex: rôles).
      allow read: if isSignedIn() && (request.auth.uid == userId || hasRole('super_admin'));
      allow write: if isSignedIn() && (request.auth.uid == userId || hasRole('super_admin'));
    }

    // --- COLLECTION CITIES (Villes) ---
    match /cities/{cityId} {
      // Tout le monde peut voir les villes (pour la recherche).
      // Seul le Super Admin peut créer/supprimer des villes.
      allow read: if true;
      allow write: if isSignedIn() && hasRole('super_admin');
    }

    // --- COLLECTION AGENCIES ---
    match /agencies/{agencyId} {
      // Tout le monde peut voir les agences.
      // Super Admin gère tout. Agency Admin peut modifier son propre document (nécessite agencyId dans le doc).
      allow read: if true;
      allow write: if isSignedIn() && (hasRole('super_admin') || (hasRole('agency_admin') && resource.data.agencyId == request.auth.uid));
    }

    // --- COLLECTION BOOKINGS ---
    match /bookings/{bookingId} {
      // L'utilisateur peut lire ses réservations.
      // Le Super Admin peut tout voir.
      // Le Station Manager de l'agence concernée peut lire pour le check-in.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        hasRole('super_admin') || 
        hasRole('station_manager')
      );
      // N'importe quel utilisateur connecté peut créer une réservation.
      allow create: if isSignedIn();
      // Seuls Super Admin ou Station Manager peuvent modifier (ex: changer statut en 'validated').
      allow update: if isSignedIn() && (hasRole('super_admin') || hasRole('station_manager'));
      allow delete: if isSignedIn() && hasRole('super_admin');
    }

    // --- COLLECTION TRIPS (Trajets) ---
    match /trips/{tripId} {
      // Lecture publique pour la recherche.
      allow read: if true;
      // Gestion par Super Admin ou Agency Admin de l'agence.
      allow write: if isSignedIn() && (hasRole('super_admin') || hasRole('agency_admin'));
    }
  }
}