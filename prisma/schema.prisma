// Easy Travel (CAMBUS2) - Prisma schema
// PostgreSQL + Next.js. Domain: Company -> Agency -> Route -> Departure -> Booking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENCY_ADMIN
  STATION_MANAGER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum DepartureStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  COMPLETED
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum BookingLeg {
  OUTBOUND
  RETURN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  BOARDED
  CANCELLED
}

enum PaymentMethod {
  MOMO
  OM
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LicenseCategory {
  B
  C
  D
  D1
  DE
}

enum IncidentKind {
  BREAKDOWN
  ACCIDENT
  ROUTE_BLOCKED
  WEATHER
  SECURITY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatar       String?
  role         Role     @default(USER)
  companyId    String?
  agencyId     String?
  stationId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  station      Station? @relation(fields: [stationId], references: [id])
  bookingGroups BookingGroup[]
  soldBookingGroups BookingGroup[] @relation("SoldBookings")
  reportedIncidents Incident[] @relation("IncidentReportedBy")
  resolvedIncidents Incident[] @relation("IncidentResolvedBy")
  auditLogs    AuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([companyId])
  @@index([agencyId])
}

model City {
  id          String    @id @default(cuid())
  name        String    @unique
  region      String
  lat         Float?
  lng         Float?
  status      Status    @default(ACTIVE)
  agencies    Agency[]
  stations    Station[]
  originRoutes      Route[] @relation("OriginCity")
  destinationRoutes Route[] @relation("DestinationCity")
  createdAt   DateTime  @default(now())
}

model Company {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logo        String?   // material icon name
  brandColor  String    @default("#13ec5b")
  description String?
  email       String?
  phone       String?
  status      Status    @default(ACTIVE)
  agencies    Agency[]
  routes      Route[]
  users       User[]
  drivers     Driver[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Agency {
  id          String    @id @default(cuid())
  companyId   String
  cityId      String
  name        String
  address     String?
  phone       String?
  email       String?
  status      Status    @default(ACTIVE)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  city        City      @relation(fields: [cityId], references: [id])
  stations    Station[]
  vehicles    Vehicle[]
  departures  Departure[]
  drivers     Driver[]
  incidents   Incident[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([cityId])
}

model Station {
  id         String     @id @default(cuid())
  agencyId   String
  cityId     String
  name       String
  address    String?
  lat        Float?
  lng        Float?
  agency     Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [cityId], references: [id])
  users      User[]
  originDepartures      Departure[] @relation("OriginStation")
  destinationDepartures Departure[] @relation("DestStation")
  createdAt  DateTime   @default(now())

  @@index([agencyId])
  @@index([cityId])
}

model Vehicle {
  id         String      @id @default(cuid())
  agencyId   String
  plate      String
  model      String
  capacity   Int
  amenities  String[]    @default([])
  seatLayout Json?
  status     Status      @default(ACTIVE)
  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  departures Departure[]
  incidents  Incident[]
  createdAt  DateTime    @default(now())

  @@unique([agencyId, plate])
}

/// Chauffeurs rattachés à une agence. La compagnie est dérivée via l'agence
/// mais dupliquée ici pour faciliter les stats compagnie (nombre de
/// chauffeurs, alertes permis expirés, temps de conduite).
model Driver {
  id                 String          @id @default(cuid())
  agencyId           String
  companyId          String
  fullName           String
  phone              String?
  licenseNumber      String
  licenseCategory    LicenseCategory @default(D)
  licenseExpiresAt   DateTime
  status             Status          @default(ACTIVE)
  agency             Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departures         Departure[]
  incidents          Incident[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([agencyId, licenseNumber])
  @@index([companyId])
  @@index([licenseExpiresAt])
}

model Route {
  id                  String      @id @default(cuid())
  companyId           String
  originCityId        String
  destinationCityId   String
  distanceKm          Int?
  defaultDurationMin  Int
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  originCity          City        @relation("OriginCity", fields: [originCityId], references: [id])
  destinationCity     City        @relation("DestinationCity", fields: [destinationCityId], references: [id])
  departures          Departure[]
  createdAt           DateTime    @default(now())

  @@unique([companyId, originCityId, destinationCityId])
  @@index([originCityId, destinationCityId])
}

model Departure {
  id                 String     @id @default(cuid())
  routeId            String
  agencyId           String
  vehicleId          String?
  driverId           String?
  originStationId    String
  destStationId      String
  departureAt        DateTime
  arrivalAt          DateTime
  priceCents         Int
  currency           String     @default("XAF")
  amenities          String[]   @default([])
  seatsTotal         Int
  seatsAvailable     Int
  status             Status     @default(ACTIVE)
  tripStatus         DepartureStatus @default(SCHEDULED)
  delayMinutes       Int?
  cancellationReason String?
  passengersNotifiedAt DateTime?
  route              Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  agency             Agency     @relation(fields: [agencyId], references: [id])
  vehicle            Vehicle?   @relation(fields: [vehicleId], references: [id])
  driver             Driver?    @relation(fields: [driverId], references: [id])
  originStation      Station    @relation("OriginStation", fields: [originStationId], references: [id])
  destStation        Station    @relation("DestStation", fields: [destStationId], references: [id])
  bookings           Booking[]
  incidents          Incident[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([routeId])
  @@index([departureAt])
  @@index([agencyId])
  @@index([driverId])
}

/// Incidents opérationnels (panne, accident, route coupée). Un incident peut
/// être rattaché à un départ, à un véhicule et/ou à un chauffeur. Indispensable
/// pour les alertes passagers et les stats de fiabilité par compagnie.
model Incident {
  id               String           @id @default(cuid())
  agencyId         String
  departureId      String?
  vehicleId        String?
  driverId         String?
  kind             IncidentKind
  severity         IncidentSeverity @default(MEDIUM)
  description      String
  reportedByUserId String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNote   String?
  agency           Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  departure        Departure?       @relation(fields: [departureId], references: [id])
  vehicle          Vehicle?         @relation(fields: [vehicleId], references: [id])
  driver           Driver?          @relation(fields: [driverId], references: [id])
  reportedBy       User?            @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id])
  resolvedBy       User?            @relation("IncidentResolvedBy", fields: [resolvedByUserId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([agencyId, createdAt])
  @@index([departureId])
  @@index([resolvedAt])
}

/// Journal d'audit générique des mutations admin (modifications de prix,
/// annulations, désactivations, création / suppression de drivers, etc.).
/// Les payloads `before` / `after` sont stockés en JSON libre — volontairement
/// pas typés au niveau Prisma pour éviter une explosion de modèles.
model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorRole     Role?
  action        String
  entityType    String
  entityId      String
  metadata      Json?
  ip            String?
  userAgent     String?
  actor         User?    @relation(fields: [actorUserId], references: [id])
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

model BookingGroup {
  id              String        @id @default(cuid())
  userId          String?
  tripType        TripType      @default(ONE_WAY)
  contactEmail    String
  contactPhone    String
  contactName     String?
  totalCents      Int
  currency        String        @default("XAF")
  status          BookingStatus @default(CONFIRMED)
  idempotencyKey  String?       @unique
  expiresAt       DateTime?
  notifiedAt      DateTime?
  soldByUserId    String?
  channel         String?
  user            User?         @relation(fields: [userId], references: [id])
  soldBy          User?         @relation("SoldBookings", fields: [soldByUserId], references: [id])
  bookings        Booking[]
  payment         Payment?
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status, expiresAt])
  @@index([soldByUserId])
}

model Booking {
  id          String        @id @default(cuid())
  groupId     String
  departureId String
  leg         BookingLeg    @default(OUTBOUND)
  seats       String[]      @default([])
  priceCents  Int
  status      BookingStatus @default(CONFIRMED)
  qrCode      String        @unique @default(cuid())
  group       BookingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  departure   Departure     @relation(fields: [departureId], references: [id])
  passengers  Passenger[]
  bookingSeats BookingSeat[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([groupId])
  @@index([departureId])
  @@index([status])
}

/// Enforces atomic seat reservation — Postgres unique constraint prevents
/// two concurrent bookings from grabbing the same seat on the same departure.
/// Rows are deleted when the booking is cancelled / expires; active bookings
/// (PENDING/CONFIRMED/BOARDED) keep their rows.
model BookingSeat {
  id          String    @id @default(cuid())
  departureId String
  seatId      String
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([departureId, seatId])
  @@index([bookingId])
}

model Passenger {
  id        String   @id @default(cuid())
  bookingId String
  fullName  String
  idNumber  String?
  seat      String?
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(cuid())
  groupId      String        @unique
  method       PaymentMethod
  provider     String?
  phoneNumber  String?
  amountCents  Int
  currency     String        @default("XAF")
  status       PaymentStatus @default(PENDING)
  providerRef  String?
  failureReason String?
  group        BookingGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  /// Prevents duplicate webhook posts for the same provider event from
  /// creating ambiguous Payment rows. (provider, providerRef) is the natural
  /// idempotency key of a Mobile Money / card event.
  @@unique([provider, providerRef])
}
