# --- Database -----------------------------------------------------------
# Local dev: docker compose up -d (starts postgres 16 on :5432)
# Production: use a managed Postgres (Neon, Supabase, Railway) and paste the
# full connection string with sslmode=require.
DATABASE_URL="postgresql://easytravel:easytravel@localhost:5432/easytravel?schema=public"

# --- Auth ---------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 64
AUTH_SECRET="change-me-please-use-a-long-random-string-at-least-32-chars"

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Easy Travel"
# Public URL used in emails/SMS (QR link, ticket link). Default is the prod
# domain; override for staging / previews.
PUBLIC_BASE_URL="https://easytravel.cm"

# --- Scheduled jobs (Vercel Cron) ---------------------------------------
# A random token. Vercel Cron calls /api/cron/* with Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""

# --- Mobile Money via Fapshi (MTN MoMo + Orange Money) -------------------
# https://docs.fapshi.com — create a service on the Fapshi dashboard, then:
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
# "sandbox" (default, no real money; test numbers 670000000 ok / 670000001 fails)
# or "live" once your Fapshi account is activated and direct pay is enabled.
FAPSHI_ENV="sandbox"
# Set the same secret on the Fapshi dashboard next to the webhook URL
# https://<your-domain>/api/webhooks/fapshi — Fapshi echoes it in `x-wh-secret`.
FAPSHI_WEBHOOK_SECRET=""
# Without Fapshi credentials a simulator confirms every payment after 4s (phone
# ending `000` fails). It is REFUSED in production unless you opt in (demo only):
# ALLOW_SIMULATED_PAYMENTS="true"
# Legacy direct Orange / MTN webhooks (/api/webhooks/om, /api/webhooks/momo):
OM_WEBHOOK_SECRET=""
MOMO_WEBHOOK_SECRET=""

# --- Notifications (optional) -------------------------------------------
# Resend (email). When unset, email falls back to a console mock.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Easy Travel <noreply@easytravel.cm>"
# Twilio (SMS). When unset, SMS falls back to a console mock.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
